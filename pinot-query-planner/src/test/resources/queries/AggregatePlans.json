          "\n    PinotLogicalExchange(distribution=[hash])",
          "\n      PinotLogicalAggregate(group=[{}], agg#0=[$SUM0($2)], agg#1=[COUNT()], aggType=[LEAF])",
          "\n        LogicalFilter(condition=[AND(>=($2, 0), =($1, _UTF-8'pink floyd'))])",
          "\n          PinotLogicalTableScan(table=[[default, a]])",
          "\n"
        ]
      },
