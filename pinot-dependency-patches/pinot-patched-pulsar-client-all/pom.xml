<!--
  org.apache.pulsar:pulsar-client-all embeds a copy of Guava relocated into
  org.apache.pulsar.shade.com.google. This module replaces it with the managed Guava, relocated into
  the same package. It does not touch the other libraries pulsar-client-all embeds, Jackson
  included: the shared shade configuration in the root pom does not replace them either.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot-dependency-patches</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>
  <artifactId>pinot-patched-pulsar-client-all</artifactId>
  <name>Pinot Patched pulsar-client-all</name>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/../..</pinot.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client-all</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runtime dependencies of pulsar-client-all -->
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client-admin-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client-api-v5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-tls-factory-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-http-client-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api-incubator</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.github.merlimat.slog</groupId>
      <artifactId>slog</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>patch-dependency</id>
            <configuration>
              <artifactSet>
                <includes>
                  <include>org.apache.pulsar:pulsar-client-all</include>
                  <include>com.google.guava:guava</include>
                  <include>com.google.guava:failureaccess</include>
                </includes>
              </artifactSet>
              <filters combine.self="override">
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.apache.pulsar:pulsar-client-all</artifact>
                  <excludes>
                    <exclude>org/apache/pulsar/shade/com/google/common/**</exclude>
                    <exclude>org/apache/pulsar/shade/com/google/thirdparty/**</exclude>
                    <exclude>META-INF/versions/**/org/apache/pulsar/shade/com/google/common/**</exclude>
                    <exclude>META-INF/versions/**/org/apache/pulsar/shade/com/google/thirdparty/**</exclude>
                    <exclude>META-INF/maven/com.google.guava/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations combine.self="override">
                <relocation>
                  <pattern>com.google.common</pattern>
                  <shadedPattern>org.apache.pulsar.shade.com.google.common</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.google.thirdparty</pattern>
                  <shadedPattern>org.apache.pulsar.shade.com.google.thirdparty</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
