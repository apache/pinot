<!--
  org.apache.curator:curator-client embeds a full copy of Guava relocated into
  org.apache.curator.shaded.com.google. This module replaces it with the managed Guava, relocated
  into the same package.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot-dependency-patches</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>
  <artifactId>pinot-patched-curator-client</artifactId>
  <name>Pinot Patched curator-client</name>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/../..</pinot.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.curator</groupId>
      <artifactId>curator-client</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Runtime dependencies of curator-client -->
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>patch-dependency</id>
            <configuration>
              <artifactSet>
                <includes>
                  <include>org.apache.curator:curator-client</include>
                  <include>com.google.guava:guava</include>
                  <include>com.google.guava:failureaccess</include>
                </includes>
              </artifactSet>
              <filters combine.self="override">
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.apache.curator:curator-client</artifact>
                  <excludes>
                    <exclude>org/apache/curator/shaded/com/google/common/**</exclude>
                    <exclude>org/apache/curator/shaded/com/google/thirdparty/**</exclude>
                    <exclude>META-INF/versions/**/org/apache/curator/shaded/com/google/common/**</exclude>
                    <exclude>META-INF/versions/**/org/apache/curator/shaded/com/google/thirdparty/**</exclude>
                    <exclude>META-INF/maven/com.google.guava/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations combine.self="override">
                <relocation>
                  <pattern>com.google.common</pattern>
                  <shadedPattern>org.apache.curator.shaded.com.google.common</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.google.thirdparty</pattern>
                  <shadedPattern>org.apache.curator.shaded.com.google.thirdparty</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
