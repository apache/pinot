<!--
  org.apache.parquet:parquet-jackson is jackson-core, jackson-databind and jackson-annotations
  relocated into shaded.parquet.com.fasterxml.jackson. This module builds the same jar from the
  Jackson version Pinot manages.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot-dependency-patches</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>
  <artifactId>pinot-patched-parquet-jackson</artifactId>
  <name>Pinot Patched parquet-jackson</name>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/../..</pinot.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>patch-dependency</id>
            <configuration>
              <artifactSet>
                <includes>
                  <include>com.fasterxml.jackson.core:jackson-core</include>
                  <include>com.fasterxml.jackson.core:jackson-databind</include>
                  <include>com.fasterxml.jackson.core:jackson-annotations</include>
                </includes>
              </artifactSet>
              <filters combine.self="override">
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations combine.self="override">
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>shaded.parquet.com.fasterxml.jackson</shadedPattern>
                </relocation>
                <!-- Multi-release entries; see pinot-dependency-patches/pom.xml -->
                <relocation>
                  <pattern>META-INF/versions/11/com/fasterxml/jackson</pattern>
                  <shadedPattern>META-INF/versions/11/shaded/parquet/com/fasterxml/jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>META-INF/versions/17/com/fasterxml/jackson</pattern>
                  <shadedPattern>META-INF/versions/17/shaded/parquet/com/fasterxml/jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>META-INF/versions/21/com/fasterxml/jackson</pattern>
                  <shadedPattern>META-INF/versions/21/shaded/parquet/com/fasterxml/jackson</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
