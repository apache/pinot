<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>
  <artifactId>pinot-broker</artifactId>
  <name>Pinot Broker</name>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/..</pinot.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-spi</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-segment-spi</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-materialized-view</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-query-runtime</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-timeseries-spi</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-common</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-segment-local</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-core</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-query-planner</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-timeseries-planner</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-query-runtime</artifactId>
      <version>1.7.0-SNAPSHOT</version>
      <classifier>${dependency.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-common</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-controller</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-controller</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!--
      Required by ControllerTest in the pinot-controller test-jar above, which uses PinotAdminClient.
      pinot-controller declares pinot-java-client at test scope, and test-scoped dependencies are not
      transitive, so it does not reach pinot-broker's test classpath. The other consumers of the
      controller test-jar already have it, either declared directly or via pinot-integration-test-base.
    -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-java-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-query-planner</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-yammer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.tesseracta</groupId>
      <artifactId>tesseracta-annotation</artifactId>
      <version>0.1.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
        <id>tesseracta-build</id>
        <build>
            <resources>
                <resource>
                    <targetPath>${project.build.directory}/test-classes-tesseracta</targetPath>
                    <directory>src/test/resources</directory>
                </resource>
            </resources>
            <plugins>
                <plugin>
                    <groupId>io.tesseracta</groupId>
                    <artifactId>tesseracta-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>tesseracta-compile</id>
                            <configuration>
                                <srcDirsModifiedDependencies>
                                    <srcDir>../pinot-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-segment-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-segment-local/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-timeseries/pinot-timeseries-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-common/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-core/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-query-planner/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-timeseries/pinot-timeseries-planner/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-query-runtime/src/main/java/org/apache/pinot</srcDir>
                                </srcDirsModifiedDependencies>
                                <srcDirsActiveTracing>
                                    <srcDir>src/main/java/org/apache/pinot</srcDir>
                                </srcDirsActiveTracing>
                                <entryMethods>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processSqlQueryGet</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processSqlQueryPost</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processSqlWithMultiStageQueryEngineGet</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processSqlWithMultiStageQueryEnginePost</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processTimeSeriesQueryEngine</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processTimeSeriesInstantQuery</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.processSqlQueryWithBothEnginesAndCompareResults</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.cancelQuery</entryMethod>
                                    <entryMethod>org.apache.pinot.broker.api.resources.PinotClientRequest.getRunningQueries</entryMethod>
                                </entryMethods>
                            </configuration>
                        </execution>
                        <execution>
                            <id>tesseracta-testCompile</id>
                            <configuration>
                                <srcDirsModifiedDependencies>
                                    <srcDir>../pinot-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-segment-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-segment-local/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-timeseries/pinot-timeseries-spi/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-common/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-core/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-query-planner/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-timeseries/pinot-timeseries-planner/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>../pinot-query-runtime/src/main/java/org/apache/pinot</srcDir>
                                    <srcDir>src/main/java/org/apache/pinot</srcDir>
                                </srcDirsModifiedDependencies>
                                <srcDirsActiveTracing>
                                    <srcDir>src/test/java/org/apache/pinot</srcDir>
                                </srcDirsActiveTracing>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
    </profile>
  </profiles>
</project>
